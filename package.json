{
  "name": "budget-calc",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm run dev -w @budget-calc/web\" \"npm run dev -w @budget-calc/api\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "npm run db:generate -w @budget-calc/api",
    "db:migrate": "npm run db:migrate -w @budget-calc/api",
    "db:studio": "npm run db:studio -w @budget-calc/api",
    "db:seed": "npm run db:seed -w @budget-calc/api",
    "compose:up": "cd docker && docker compose up -d",
    "compose:down": "cd docker && docker compose down",
    "serve-docs": "npm run dev -w @budget-calc/docs",
    "dev:clean": "kill $(lsof -ti:3000,3001) 2>/dev/null; npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lightningcss": "^1.33.0",
    "lucide-react": "^1.25.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  }
}
